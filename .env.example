# Generate with: pnpm numen key generate
NUMEN_MASTER_KEY=
NUMEN_PORT=5140

# Required only with compose.release.yml. Prefer a published image digest.
# NUMEN_IMAGE=registry.example.com/your-project/numen:0.1.0

# Optional shared HTTP(S)/SOCKS proxy for every outbound Integration request.
# NUMEN_HTTP_PROXY=http://host.docker.internal:7890

# Optional direct destinations when a shared proxy is configured.
# NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,.home.arpa
