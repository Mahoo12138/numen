{
  "name": "@numenjs/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:app": "vite build"
  },
  "dependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "@lucide/vue": "^1.33.0",
    "@numenjs/automation": "workspace:*",
    "@numenjs/connections": "workspace:*",
    "@numenjs/console": "workspace:*",
    "@numenjs/core": "workspace:*",
    "@numenjs/credentials": "workspace:*",
    "@numenjs/i18n": "workspace:*",
    "@numenjs/scheduler": "workspace:*",
    "@numenjs/webui": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "schemastery": "^3.18.0",
    "vue": "^3.5.0",
    "@numenjs/logging": "workspace:*",
    "@numenjs/components": "workspace:*"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "vite": "^7.3.2"
  }
}
