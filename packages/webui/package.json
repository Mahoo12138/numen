{
  "name": "@numenjs/webui",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "default": "./dist/extensions.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./schema-ui": {
      "types": "./dist/schema-ui.d.ts",
      "default": "./dist/schema-ui.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    }
  },
  "dependencies": {
    "@numenjs/console": "workspace:*",
    "@numenjs/i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@cordisjs/plugin-server": "^1.7.0",
    "schemastery": "^3.18.0",
    "ws": "^8.19.0",
    "cordis": "4.0.0-rc.8"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.8"
  },
  "description": "Browser runtime and lifecycle-owned extension registries for Numen"
}
